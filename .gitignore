# Secrets / credentials — NEVER commit
.env
*.env.local
credentials.json
secrets/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/

# Data and models (too large / regeneratable)
data/raw/omie_pt_zips/
data/raw/entsoe/
data/raw/omie_es_zips/
*.pkl
logs/*.log

# OMIEForecast subfolder — exclude raw downloads and logs, keep processed
# outputs and trained models (≈10 MB total — needed by the dashboard).
omie_forecast/data/raw/
omie_forecast/logs/
# Per-hour training sets are a pure re-slice of master_hourly.csv
# (02_build_features does `df[df.index.hour == h]` — same rows, same columns,
# another 44 MB). 02 regenerates them before 03/03b/04 read them, and the
# dashboard never opens them, so they are build artifacts, not source data.
omie_forecast/data/processed/hourly_dataset_h*.csv
# Allow the 48 OMIE model pkls (LASSO + LightGBM boosters) through the
# global "*.pkl" rule above.
!omie_forecast/models/
!omie_forecast/models/*.pkl
!omie_forecast/models/*.csv

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db
